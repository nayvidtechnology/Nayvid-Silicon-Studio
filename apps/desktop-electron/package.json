{
  "name": "nayvid-desktop-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "start": "pnpm --filter nayvid-renderer build && tsc && electron .",
    "dist": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.nayvid.siliconstudio",
    "productName": "Nayvid Silicon Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../renderer/dist/**/*",
      "../../packages/**/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@nayvid/agent-tools": "workspace:*",
    "@nayvid/ai-core": "workspace:*",
    "@nayvid/execution-runtime": "workspace:*",
    "@nayvid/model-providers": "workspace:*",
    "@nayvid/platform-core": "workspace:*",
    "@nayvid/tool-registry": "workspace:*",
    "nayvid-renderer": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
